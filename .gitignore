# Browser dependencies and generated output
/node_modules/
/dist/
/.github-export/

# Unity generated output (preserve Assets, Packages, ProjectSettings and .meta)
Unity/Vesper/[Ll]ibrary/
Unity/Vesper/[Tt]emp/
Unity/Vesper/[Oo]bj/
Unity/Vesper/[Ll]ogs/
Unity/Vesper/[Uu]ser[Ss]ettings/
Unity/Vesper/[Bb]uild/
Unity/Vesper/[Bb]uilds/
Unity/Vesper/[Mm]emoryCaptures/
Unity/Vesper/[Rr]ecordings/
Unity/Vesper/.vs/
Unity/Vesper/*.csproj
Unity/Vesper/*.sln*

# Historical evidence: retain reports/data; archive repeated media locally.
# Tracked files stay in source history. Tools/export_github.py filters these
# using --no-index when making a new upload snapshot.
/Migration/Evidence/**/*
!/Migration/Evidence/**/
!/Migration/Evidence/**/*.md
!/Migration/Evidence/**/*.json
!/Migration/Evidence/**/*.csv
!/Migration/Evidence/**/*.txt
!/Migration/Evidence/**/*.html
!/Migration/Evidence/**/*.cmd
!/Migration/Evidence/**/*.cs

# Current W10 evidence, including its six full-resolution screenshots.
!/Migration/Evidence/Expansion/WeatherWorld/W10/**

# Local sessions, editor files and authoring backups (including nested copies)
.dream-loop/
.vs/
.idea/
__pycache__/
*.py[cod]
*.blend[0-9]*
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and credentials
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.p12
*.key
*.pem

# Wwise local authoring cache, downloaded SDK documentation and debug symbols.
/Audio/VesperAudio/.cache/
/Audio/VesperAudio/.backup/
/Audio/VesperAudio/*.wsettings
/Audio/VesperAudio/*.akd
/Audio/VesperAudio/*.prof
/Unity/Vesper_WwiseIntegrationTemp/
/Unity/Vesper/Assets/Wwise/Documentation/
/Unity/Vesper/Assets/Wwise/Documentation.meta
*.pdb
*.pdb.meta
*.dSYM/
*.dSYM.meta
# The capture is available locally; its measured signal report is versioned.
/Audio/unity-wwise-validation*.wav
